{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shell-echo:sandbox-runtime:contract:runtime-session-handoff:v1",
  "title": "Sandbox Runtime Terminal Session Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "attempt_id",
    "fencing_token",
    "sandbox_id",
    "runtime_session_id",
    "runtime_type",
    "capability_profile_id",
    "protocol",
    "internal_endpoint_reference",
    "connection_generation",
    "expires_at"
  ],
  "properties": {
    "operation_id": {"$ref": "#/$defs/Identifier"},
    "attempt_id": {"$ref": "#/$defs/Identifier"},
    "fencing_token": {"type": "integer", "minimum": 1},
    "sandbox_id": {"$ref": "#/$defs/Identifier"},
    "runtime_session_id": {"$ref": "#/$defs/Identifier"},
    "runtime_type": {"const": "terminal"},
    "capability_profile_id": {"$ref": "#/$defs/Identifier"},
    "protocol": {"const": "websocket"},
    "internal_endpoint_reference": {"type": "string", "pattern": "^ref:session:[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
    "connection_generation": {"type": "integer", "minimum": 1},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "Identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"}
  }
}
