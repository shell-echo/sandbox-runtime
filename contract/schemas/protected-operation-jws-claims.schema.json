{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shell-echo:sandbox-runtime:contract:protected-operation-jws-claims:v1",
  "title": "Sandbox Runtime Protected Operation JWS Claims",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jti",
    "iss",
    "sub",
    "aud",
    "iat",
    "nbf",
    "exp",
    "operation",
    "provider_revision_id",
    "sandbox_id",
    "operation_id",
    "attempt_id",
    "fencing_token",
    "tenant_id",
    "work_order_id",
    "policy_digest",
    "policy_decided_at",
    "request_contract_id",
    "request_digest_profile",
    "request_digest",
    "deadline_at",
    "admission_context_contract_id",
    "admission_context_digest_profile",
    "admission_context_digest"
  ],
  "properties": {
    "jti": {"type": "string", "minLength": 16, "maxLength": 200},
    "iss": {"type": "string", "minLength": 1, "maxLength": 200, "description": "JWT StringOrURI without a fragment; exact configured-issuer and URI semantics are defined by protected-admission-issuer-local-authority-binding."},
    "sub": {"type": "string", "minLength": 1, "maxLength": 200},
    "aud": {"type": "string", "pattern": "^urn:shell-echo:sandbox-runtime:provider-instance:[A-Za-z0-9._:-]{1,200}$"},
    "iat": {"type": "integer", "minimum": 0},
    "nbf": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 0},
    "operation": {"enum": ["create", "restore", "read_sandbox", "set_desired_state", "extend_lease", "exec", "cancel_exec", "open_runtime_session", "open_browser_session", "stage_artifact", "snapshot", "terminate", "read_operation", "read_result", "read_runtime_session", "read_browser_session", "read_artifact_staging_evidence", "read_usage_evidence", "read_snapshot_manifest", "read_events"]},
    "provider_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "sandbox_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "work_order_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_decided_at": {"type": "string", "format": "date-time"},
    "request_contract_id": {"type": "string", "pattern": "^urn:shell-echo:sandbox-runtime:(request|descriptor):[a-z0-9-]+:v1$"},
    "request_digest_profile": {"enum": ["rfc8785-request-excluding-request-digest-v1", "rfc8785-full-document-v1"]},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "deadline_at": {"type": "string", "format": "date-time"},
    "admission_context_contract_id": {"const": "urn:shell-echo:sandbox-runtime:admission-context:v1"},
    "admission_context_digest_profile": {"const": "rfc8785-full-document-excluding-context-digest-v1"},
    "admission_context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
