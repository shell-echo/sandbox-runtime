{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shell-echo:sandbox-runtime:contract:lifecycle-event-page:v1",
  "title": "Sandbox Lifecycle Event Page",
  "type": "object",
  "additionalProperties": false,
  "required": ["events", "first_available_sequence", "latest_sequence", "next_sequence"],
  "properties": {
    "events": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/Event"}},
    "first_available_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "latest_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "next_sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  },
  "$defs": {
    "Identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "Event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sandbox_id", "operation_id", "sequence", "generation", "fencing_token", "kind", "occurred_at"],
      "properties": {
        "event_id": {"$ref": "#/$defs/Identifier"},
        "sandbox_id": {"$ref": "#/$defs/Identifier"},
        "operation_id": {"$ref": "#/$defs/Identifier"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "generation": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "kind": {"$ref": "#/$defs/Identifier"},
        "data_digest": {"$ref": "#/$defs/Digest"},
        "occurred_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
