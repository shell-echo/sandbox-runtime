{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shell-echo:sandbox-runtime:contract:admission-context:v1",
  "title": "Sandbox Runtime Protected Admission Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_contract_id",
    "context_digest_profile",
    "context_digest",
    "controller_subject",
    "provider_revision_id",
    "provider_instance_audience",
    "tenant_id",
    "work_order_id",
    "policy_digest",
    "policy_decided_at",
    "operation",
    "sandbox_id",
    "operation_id",
    "attempt_id",
    "fencing_token",
    "deadline_at",
    "request_contract_id",
    "request_digest_profile",
    "request_digest",
    "http_target"
  ],
  "properties": {
    "context_contract_id": {"const": "urn:shell-echo:sandbox-runtime:admission-context:v1"},
    "context_digest_profile": {"const": "rfc8785-full-document-excluding-context-digest-v1"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "controller_subject": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider_revision_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "provider_instance_audience": {"type": "string", "pattern": "^urn:shell-echo:sandbox-runtime:provider-instance:[A-Za-z0-9._:-]{1,200}$"},
    "tenant_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "work_order_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "policy_decided_at": {"type": "string", "format": "date-time"},
    "operation": {"enum": ["create", "restore", "read_sandbox", "set_desired_state", "extend_lease", "exec", "cancel_exec", "open_runtime_session", "snapshot", "terminate", "read_operation", "read_result", "read_snapshot_manifest", "read_events"]},
    "sandbox_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "fencing_token": {"type": "integer", "minimum": 1},
    "deadline_at": {"type": "string", "format": "date-time"},
    "request_contract_id": {"type": "string", "pattern": "^urn:shell-echo:sandbox-runtime:(request|descriptor):[a-z0-9-]+:v1$"},
    "request_digest_profile": {"enum": ["rfc8785-request-excluding-request-digest-v1", "rfc8785-full-document-v1"]},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "http_target": {"$ref": "urn:shell-echo:sandbox-runtime:contract:admission-target:v1"}
  }
}
