{
  "namespace": "urn:shell-echo:sandbox-runtime:provider-v1",
  "version": "1.0.0",
  "rules": [
    {"id": "capabilities-mtls-only", "method": "GET", "path": "/v1/capabilities", "requires": ["verified-client-certificate", "admitted-uri-san"]},
    {"id": "capabilities-no-bearer-substitution", "method": "GET", "path": "/v1/capabilities", "forbids": ["bearer-as-mtls-identity"]},
    {"id": "capabilities-request-empty", "method": "GET", "path": "/v1/capabilities", "request": {"query": "forbidden", "body": "forbidden", "content_length": "zero-only", "transfer_encoding": "identity-only"}},
    {"id": "capabilities-snapshot-immutable", "method": "GET", "path": "/v1/capabilities", "response": {"capabilities": "immutable-array; empty-when-terminal-disabled", "runtime_profiles": "immutable-array; empty-when-terminal-disabled", "snapshot_restore_profiles": "metadata-only"}},
    {"id": "capabilities-terminal-profile-advertisement", "method": "GET", "path": "/v1/capabilities", "scope": "terminal-session-advertisement", "requires": ["terminal-disabled-means-zero-terminal-advertisement", "sandbox-terminal-capability-must-advertise-at-least-one-version", "terminal-capability-profile-must-be-listed-under-sandbox-terminal", "terminal-capability-profile-must-map-to-an-advertised-runtime-profile", "session-admission-must-match-exact-advertised-capability-version-profile-and-runtime-profile"], "response": {"capability_id": "sandbox.terminal", "capability_profile_to_runtime_profile": "explicit-capability_profile_ids"}, "forbids": ["implicit-terminal-capability", "unadvertised-terminal-profile", "cross-runtime-profile-fallback"]},
    {"id": "capabilities-no-mutation-dispatch", "method": "GET", "path": "/v1/capabilities", "forbids": ["repository-dispatch", "driver-dispatch", "lifecycle-dispatch"]}
    ,{"id": "protected-admission-mtls-and-bearer", "scope": "protected-operations", "requires": ["verified-client-certificate", "admitted-uri-san", "short-lived-jws-bearer"]}
    ,{"id": "protected-admission-binding", "scope": "protected-operations", "requires": ["provider-revision-binding", "caller-binding", "request-or-descriptor-digest-binding", "deadline-binding", "policy-decision-binding"]}
    ,{"id": "protected-admission-replay-fencing", "scope": "protected-mutations", "requires": ["jti-replay-rejection", "stale-fencing-rejection", "fail-before-dispatch"]}
    ,{"id": "protected-admission-contract-ids", "scope": "protected-operations", "contract_id_namespace": "urn:shell-echo:sandbox-runtime", "digest_profiles": ["rfc8785-request-excluding-request-digest-v1", "rfc8785-full-document-v1"], "operation_bindings": [
      {"operation": "create", "contract_id": "urn:shell-echo:sandbox-runtime:request:create:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "restore", "contract_id": "urn:shell-echo:sandbox-runtime:request:restore:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "set_desired_state", "contract_id": "urn:shell-echo:sandbox-runtime:request:set-desired-state:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "extend_lease", "contract_id": "urn:shell-echo:sandbox-runtime:request:extend-lease:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "exec", "contract_id": "urn:shell-echo:sandbox-runtime:request:exec:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "cancel_exec", "contract_id": "urn:shell-echo:sandbox-runtime:request:cancel-exec:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "open_runtime_session", "contract_id": "urn:shell-echo:sandbox-runtime:request:open-runtime-session:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "snapshot", "contract_id": "urn:shell-echo:sandbox-runtime:request:snapshot:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "terminate", "contract_id": "urn:shell-echo:sandbox-runtime:request:terminate:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "read_sandbox", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:status:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_operation", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:operation:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_result", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:exec-result:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_runtime_session", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:runtime-session:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_snapshot_manifest", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:snapshot-manifest:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_events", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:events:v1", "digest_profile": "rfc8785-full-document-v1"}
    ]},
    {"id": "lifecycle-create-request", "method": "POST", "path": "/v1/sandboxes", "requires": ["protected-admission", "strict-create-request-schema", "provider-revision-bound-spec", "pinned-image-digest", "safe-security-policy"], "request": {"body_schema": "create-sandbox-request.schema.json", "max_encoded_bytes": 1048576, "unknown_fields": "forbidden"}, "response": {"accepted_status": 202, "operation_schema": "provider-operation.schema.json"}},
    {"id": "lifecycle-create-idempotency", "method": "POST", "path": "/v1/sandboxes", "requires": ["idempotency-key-and-request-digest", "same-key-same-digest-same-operation", "same-key-different-digest-conflict"], "conflicts": {"status": 409, "code": "SANDBOX_IDEMPOTENCY_CONFLICT"}},
    {"id": "lifecycle-generation-fencing", "scope": "lifecycle-mutations", "requires": ["positive-fencing-token", "create-generation-is-one", "stale-attempt-fails-before-dispatch", "newer-generation-cannot-be-overwritten"], "conflicts": {"generation_status": 409, "generation_code": "SANDBOX_GENERATION_CONFLICT", "fencing_status": 409, "fencing_code": "SANDBOX_STALE_FENCING_TOKEN"}},
    {"id": "lifecycle-deadline-and-outcome", "scope": "lifecycle-mutations", "requires": ["deadline-required", "deadline-checked-before-dispatch", "cancellation-is-intent", "lost-response-may-be-outcome-unknown"], "outcomes": {"states": ["accepted", "running", "succeeded", "failed", "cancelled", "outcome_unknown"], "known_failure": "failed", "unknown_failure": "outcome_unknown"}},
    {"id": "lifecycle-read-is-bounded", "scope": "lifecycle-reads", "requires": ["protected-admission", "opaque-identifiers-only", "no-repository-or-driver-mutation-dispatch", "bounded-retention-errors"], "routes": ["GET /v1/sandboxes/{sandbox_id}", "GET /v1/operations/{operation_id}"], "forbids": ["container-id", "host-path", "raw-endpoint", "secret", "credential"]},
    {"id": "exec-request-bounded", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/exec", "scope": "exec-operations", "requires": ["protected-admission", "strict-exec-request-schema", "structured-argv-command-array", "working-directory-under-stable-mount", "environment-values-are-opaque-references", "stdin-is-none-or-opaque-reference", "deadline-required", "bounded-output-capture", "result-retention-bound"], "request": {"body_schema": "exec-request.schema.json", "max_encoded_bytes": 262144, "unknown_fields": "forbidden"}, "forbids": ["arbitrary-shell-command-string", "plaintext-secret", "host-path", "container-id"]},
    {"id": "exec-cancellation-intent", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/exec:cancel", "scope": "exec-operations", "requires": ["protected-admission", "strict-cancel-exec-request-schema", "cancellation-is-intent", "target-operation-and-attempt-binding", "deadline-required", "fail-before-dispatch-on-stale-fencing"], "request": {"body_schema": "cancel-exec-request.schema.json", "max_encoded_bytes": 65536, "unknown_fields": "forbidden"}, "responses": {"accepted_status": 202, "unknown_target_status": 404, "unsupported_target_status": 422}, "forbids": ["unconfirmed-cancelled-claim"]},
    {"id": "exec-result-retention", "method": "GET", "path": "/v1/operations/{operation_id}/exec-result", "scope": "exec-results", "requires": ["protected-admission", "strict-exec-result-schema", "outcome-unknown-is-explicit", "retained-until-expiry", "expired-result-is-410", "opaque-result-references", "no-backend-leakage"], "response": {"schema": "exec-result.schema.json", "expired_status": 410}, "forbids": ["container-id", "host-path", "raw-endpoint", "secret", "credential", "unbounded-output"]}
    ,{"id": "runtime-session-open-bounded", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/runtime-sessions", "scope": "terminal-sessions", "requires": ["protected-admission", "strict-runtime-session-open-request-schema", "terminal-capability-and-profile-required", "provider-revision-sandbox-generation-binding", "idempotency-key-and-request-digest", "deadline-and-expiry-bound", "fail-before-dispatch-on-stale-fencing"], "request": {"body_schema": "runtime-session-open-request.schema.json", "max_encoded_bytes": 65536, "unknown_fields": "forbidden"}, "response": {"accepted_status": 202, "operation_schema": "provider-operation.schema.json"}, "forbids": ["browser-runtime", "desktop-runtime", "port-forward-runtime", "gateway-user-scope", "target-port", "plaintext-secret"]}
    ,{"id": "runtime-session-gateway-handoff", "method": "GET", "path": "/v1/operations/{operation_id}/runtime-session", "scope": "terminal-sessions", "requires": ["protected-admission", "operation-attempt-fencing-binding", "terminal-handoff-schema", "opaque-internal-endpoint-reference", "gateway-resolves-reference-under-independent-user-authorization", "connection-generation", "expiry-enforced", "expired-handoff-is-410", "unknown-outcome-never-mints-handoff"], "response": {"schema": "runtime-session-handoff.schema.json", "expired_status": 410}, "forbids": ["url", "ip-address", "port", "container-id", "pod-name", "host-path", "backend-token", "credential", "provider-access-token-reference"]}
  ]
}
