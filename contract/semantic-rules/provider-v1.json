{
  "namespace": "urn:shell-echo:sandbox-runtime:provider-v1",
  "version": "1.0.0",
  "rules": [
    {"id": "capabilities-mtls-only", "method": "GET", "path": "/v1/capabilities", "requires": ["verified-client-certificate", "admitted-uri-san"]},
    {"id": "capabilities-no-bearer-substitution", "method": "GET", "path": "/v1/capabilities", "forbids": ["bearer-as-mtls-identity"]},
    {"id": "capabilities-request-empty", "method": "GET", "path": "/v1/capabilities", "request": {"query": "forbidden", "body": "forbidden", "content_length": "zero-only", "transfer_encoding": "identity-only"}},
    {"id": "capabilities-snapshot-immutable", "method": "GET", "path": "/v1/capabilities", "response": {"capabilities": "immutable-array; empty-terminal-or-coding-shell", "runtime_profiles": "immutable-array; empty-terminal-or-coding-shell", "snapshot_restore_profiles": "metadata-only"}},
    {"id": "capabilities-terminal-profile-advertisement", "method": "GET", "path": "/v1/capabilities", "scope": "terminal-session-advertisement", "requires": ["terminal-disabled-means-zero-advertisement", "sandbox-terminal-capability-must-advertise-at-least-one-version", "advertised-terminal-version-must-be-sandbox-capability-requirement-compatible-semver", "terminal-capability-profile-must-be-listed-under-sandbox-terminal", "terminal-capability-profile-must-map-to-an-advertised-runtime-profile", "terminal-capability-profile-must-match-runtime-session-fixtures", "session-admission-must-match-exact-advertised-capability-version-profile-and-runtime-profile"], "response": {"capability_id": "sandbox.terminal", "capability_profile_to_runtime_profile": "explicit-capability_profile_ids"}, "forbids": ["implicit-terminal-capability", "unadvertised-terminal-profile", "cross-runtime-profile-fallback", "non-terminal-capability-in-terminal-only-snapshot", "runtime-profile-without-terminal-capability"]},
    {"id": "capabilities-coding-shell-profile-advertisement", "method": "GET", "path": "/v1/capabilities", "scope": "coding-shell-advertisement", "requires": ["coding-shell-advertisement-is-atomic", "sandbox-exec-version-1.0.0-with-exec-v1-profile", "sandbox-terminal-version-1.0.0-with-terminal-v1-profile", "both-capability-profiles-map-to-one-canonical-runtime-profile", "create-fixture-requires-exact-advertised-runtime-and-capabilities", "runtime-session-fixtures-use-terminal-v1", "stable-inputs-workspace-outputs-and-tmp-mount-semantics", "artifact-staging-and-usage-evidence-routes-remain-required", "disabled-composition-means-zero-advertisement"], "response": {"capability_ids": ["sandbox.exec", "sandbox.terminal"], "capability_profiles": ["exec-v1", "terminal-v1"], "runtime_profile_id": "sandbox-runtime-coding-shell-v1", "capability_profile_to_runtime_profile": "explicit-capability_profile_ids", "stable_mounts": ["/inputs", "/workspace", "/outputs", "/tmp"], "required_evidence_routes": ["GET /v1/operations/{operation_id}/artifact-staging-evidence", "GET /v1/operations/{operation_id}/usage-evidence"]}, "forbids": ["partial-coding-shell-advertisement", "split-capability-profiles-across-runtime-profiles", "unadvertised-capability-profile", "unknown-capability-in-coding-shell-snapshot", "advertisement-without-complete-runtime-dependencies"]},
    {"id": "capabilities-no-mutation-dispatch", "method": "GET", "path": "/v1/capabilities", "forbids": ["repository-dispatch", "driver-dispatch", "lifecycle-dispatch"]}
    ,{"id": "protected-admission-mtls-and-bearer", "scope": "protected-operations", "requires": ["verified-client-certificate", "admitted-uri-san", "short-lived-jws-bearer"]}
    ,{"id": "protected-admission-binding", "scope": "protected-operations", "requires": ["provider-revision-binding", "caller-binding", "request-or-descriptor-digest-binding", "deadline-binding", "policy-decision-binding"]}
    ,{"id": "protected-admission-replay-fencing", "scope": "protected-mutations", "requires": ["jti-replay-rejection", "stale-fencing-rejection", "fail-before-dispatch"]}
    ,{"id": "protected-admission-contract-ids", "scope": "protected-operations", "contract_id_namespace": "urn:shell-echo:sandbox-runtime", "digest_profiles": ["rfc8785-request-excluding-request-digest-v1", "rfc8785-full-document-v1"], "operation_bindings": [
      {"operation": "create", "contract_id": "urn:shell-echo:sandbox-runtime:request:create:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "restore", "contract_id": "urn:shell-echo:sandbox-runtime:request:restore:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "set_desired_state", "contract_id": "urn:shell-echo:sandbox-runtime:request:set-desired-state:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "extend_lease", "contract_id": "urn:shell-echo:sandbox-runtime:request:extend-lease:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "exec", "contract_id": "urn:shell-echo:sandbox-runtime:request:exec:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "cancel_exec", "contract_id": "urn:shell-echo:sandbox-runtime:request:cancel-exec:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "open_runtime_session", "contract_id": "urn:shell-echo:sandbox-runtime:request:open-runtime-session:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "stage_artifact", "contract_id": "urn:shell-echo:sandbox-runtime:request:stage-artifact:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "snapshot", "contract_id": "urn:shell-echo:sandbox-runtime:request:snapshot:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "terminate", "contract_id": "urn:shell-echo:sandbox-runtime:request:terminate:v1", "digest_profile": "rfc8785-request-excluding-request-digest-v1"},
      {"operation": "read_sandbox", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:status:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_operation", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:operation:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_result", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:exec-result:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_runtime_session", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:runtime-session:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_artifact_staging_evidence", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:artifact-staging-evidence:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_usage_evidence", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:usage-evidence:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_snapshot_manifest", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:snapshot-manifest:v1", "digest_profile": "rfc8785-full-document-v1"},
      {"operation": "read_events", "contract_id": "urn:shell-echo:sandbox-runtime:descriptor:events:v1", "digest_profile": "rfc8785-full-document-v1"}
    ]},
    {"id": "lifecycle-create-request", "method": "POST", "path": "/v1/sandboxes", "requires": ["protected-admission", "strict-create-request-schema", "provider-revision-bound-spec", "pinned-image-digest", "safe-security-policy"], "request": {"body_schema": "create-sandbox-request.schema.json", "max_encoded_bytes": 1048576, "unknown_fields": "forbidden"}, "response": {"accepted_status": 202, "operation_schema": "provider-operation.schema.json"}},
    {"id": "lifecycle-create-idempotency", "method": "POST", "path": "/v1/sandboxes", "requires": ["idempotency-key-and-request-digest", "same-key-same-digest-same-operation", "same-key-different-digest-conflict"], "conflicts": {"status": 409, "code": "SANDBOX_IDEMPOTENCY_CONFLICT"}},
    {"id": "lifecycle-generation-fencing", "scope": "lifecycle-mutations", "requires": ["positive-fencing-token", "create-generation-is-one", "stale-attempt-fails-before-dispatch", "newer-generation-cannot-be-overwritten"], "conflicts": {"generation_status": 409, "generation_code": "SANDBOX_GENERATION_CONFLICT", "fencing_status": 409, "fencing_code": "SANDBOX_STALE_FENCING_TOKEN"}},
    {"id": "lifecycle-deadline-and-outcome", "scope": "lifecycle-mutations", "requires": ["deadline-required", "deadline-checked-before-dispatch", "cancellation-is-intent", "lost-response-may-be-outcome-unknown"], "outcomes": {"states": ["accepted", "running", "succeeded", "failed", "cancelled", "outcome_unknown"], "known_failure": "failed", "unknown_failure": "outcome_unknown"}},
    {"id": "lifecycle-read-is-bounded", "scope": "lifecycle-reads", "requires": ["protected-admission", "opaque-identifiers-only", "no-repository-or-driver-mutation-dispatch", "bounded-retention-errors"], "routes": ["GET /v1/sandboxes/{sandbox_id}", "GET /v1/operations/{operation_id}"], "forbids": ["container-id", "host-path", "raw-endpoint", "secret", "credential"]},
    {"id": "exec-request-bounded", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/exec", "scope": "exec-operations", "requires": ["protected-admission", "strict-exec-request-schema", "structured-argv-command-array", "working-directory-under-stable-mount", "environment-values-are-opaque-references", "stdin-is-none-or-opaque-reference", "deadline-required", "bounded-output-capture", "result-retention-bound"], "request": {"body_schema": "exec-request.schema.json", "max_encoded_bytes": 262144, "unknown_fields": "forbidden"}, "forbids": ["arbitrary-shell-command-string", "plaintext-secret", "host-path", "container-id"]},
    {"id": "exec-cancellation-intent", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/exec:cancel", "scope": "exec-operations", "requires": ["protected-admission", "strict-cancel-exec-request-schema", "cancellation-is-intent", "target-operation-and-attempt-binding", "deadline-required", "fail-before-dispatch-on-stale-fencing"], "request": {"body_schema": "cancel-exec-request.schema.json", "max_encoded_bytes": 65536, "unknown_fields": "forbidden"}, "responses": {"accepted_status": 202, "unknown_target_status": 404, "unsupported_target_status": 422}, "forbids": ["unconfirmed-cancelled-claim"]},
    {"id": "exec-result-retention", "method": "GET", "path": "/v1/operations/{operation_id}/exec-result", "scope": "exec-results", "requires": ["protected-admission", "strict-exec-result-schema", "outcome-unknown-is-explicit", "retained-until-expiry", "expired-result-is-410", "opaque-result-references", "no-backend-leakage"], "response": {"schema": "exec-result.schema.json", "expired_status": 410}, "forbids": ["container-id", "host-path", "raw-endpoint", "secret", "credential", "unbounded-output"]}
    ,{"id": "runtime-session-open-bounded", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/runtime-sessions", "scope": "terminal-sessions", "requires": ["protected-admission", "strict-runtime-session-open-request-schema", "terminal-capability-and-profile-required", "provider-revision-sandbox-generation-binding", "idempotency-key-and-request-digest", "deadline-and-expiry-bound", "fail-before-dispatch-on-stale-fencing"], "request": {"body_schema": "runtime-session-open-request.schema.json", "max_encoded_bytes": 65536, "unknown_fields": "forbidden"}, "response": {"accepted_status": 202, "operation_schema": "provider-operation.schema.json"}, "forbids": ["browser-runtime", "desktop-runtime", "port-forward-runtime", "gateway-user-scope", "target-port", "plaintext-secret"]}
    ,{"id": "runtime-session-gateway-handoff", "method": "GET", "path": "/v1/operations/{operation_id}/runtime-session", "scope": "terminal-sessions", "requires": ["protected-admission", "operation-attempt-fencing-binding", "terminal-handoff-schema", "opaque-internal-endpoint-reference", "gateway-resolves-reference-under-independent-user-authorization", "connection-generation", "expiry-enforced", "expired-handoff-is-410", "unknown-outcome-never-mints-handoff"], "response": {"schema": "runtime-session-handoff.schema.json", "expired_status": 410}, "forbids": ["url", "ip-address", "port", "container-id", "pod-name", "host-path", "backend-token", "credential", "provider-access-token-reference"]}
    ,{"id": "artifact-staging-request-bounded", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/artifacts:stage", "scope": "artifact-staging", "requires": ["protected-admission", "strict-artifact-staging-request-schema", "artifact-reference-is-opaque", "source-path-under-outputs", "digest-media-type-and-size-bounds", "tenant-binding-from-admission-context", "active-content-check-before-stage", "malware-check-before-stage", "idempotency-key-and-request-digest", "provider-revision-sandbox-generation-binding", "expiry-bound"], "request": {"body_schema": "artifact-staging-request.schema.json", "max_encoded_bytes": 65536, "unknown_fields": "forbidden"}, "response": {"accepted_status": 202, "operation_schema": "provider-operation.schema.json"}, "forbids": ["public-artifact-url", "artifact-authority", "billing-truth", "host-path", "credential"]}
    ,{"id": "artifact-staging-asynchronous-outcomes", "method": "POST", "path": "/v1/sandboxes/{sandbox_id}/artifacts:stage", "scope": "artifact-staging", "requires": ["durable-accept-before-staging-dispatch", "accept-response-is-operation-only", "source-and-content-check-outcomes-are-not-synchronous-accept-responses", "safe-errors-only"], "pre_accept_errors": {"encoded_body_too_large": 400, "unsupported_check_capability": 422, "unsafe_or_unprojectable_internal_failure": 503, "forbidden_statuses": [413, 500]}, "terminal_outcomes": {"staged": {"operation_status": "succeeded", "operation_read_status": 200, "evidence_status": "staged", "evidence_read_status": 200}, "content_rejected": {"operation_status": "failed", "operation_read_status": 200, "evidence_status": "rejected", "evidence_read_status": 200}, "source_missing": {"operation_status": "failed", "operation_read_status": 200, "evidence_status": "absent", "evidence_read_status": 404}}}
    ,{"id": "artifact-staging-evidence-bounded", "method": "GET", "path": "/v1/operations/{operation_id}/artifact-staging-evidence", "scope": "artifact-staging-evidence", "requires": ["protected-admission", "strict-artifact-staging-evidence-schema", "expected-digest-media-type-and-size-binding", "tenant-binding-check-evidence", "active-content-check-evidence", "malware-check-evidence", "opaque-staging-reference", "expiry-enforced", "expired-evidence-is-410"], "response": {"schema": "artifact-staging-evidence.schema.json", "expired_status": 410}, "forbids": ["public-artifact-url", "artifact-authority", "billing-truth", "host-path", "credential"]}
    ,{"id": "usage-evidence-bounded", "method": "GET", "path": "/v1/operations/{operation_id}/usage-evidence", "scope": "usage-evidence", "requires": ["protected-admission", "strict-usage-evidence-schema", "operation-and-sandbox-correlation", "bounded-meter-dimensions", "reconciliation-status-explicit", "expiry-enforced", "expired-evidence-is-410"], "response": {"schema": "usage-evidence.schema.json", "expired_status": 410}, "forbids": ["billing-total", "price", "currency", "rate", "tenant-authority", "credential"]}
    ,{"id": "artifact-usage-read-descriptor-digests", "scope": "artifact-usage-evidence-reads", "routes": ["GET /v1/operations/{operation_id}/artifact-staging-evidence", "GET /v1/operations/{operation_id}/usage-evidence"], "requires": ["protected-admission", "path-operation-id-equals-admission-context-operation-id", "empty-normalized-query", "rfc8785-full-document-digest"], "descriptor": {"fields": ["operation", "sandbox_id", "operation_id", "attempt_id", "fencing_token"], "additional_fields": "forbidden"}}
    ,{"id": "provider-operation-read-aggregation", "method": "GET", "path": "/v1/operations/{operation_id}", "scope": "provider-operation-reads", "requires": ["protected-admission", "operation-family-authority-aggregation", "artifact-stage-operation-is-readable", "known-operation-is-not-hidden-by-an-unrelated-family-miss", "caller-safe-operation-projection"], "operation_types": ["create", "exec", "cancel_exec", "open_runtime_session", "artifact_stage"], "not_found": {"status": 404, "condition": "operation-is-unknown-to-every-composed-family-authority"}, "forbids": ["lifecycle-only-route-ownership", "backend-detail", "host-path", "credential"]}
    ,{"id": "artifact-usage-evidence-read-state-matrix", "scope": "artifact-usage-evidence-reads", "requires": ["protected-admission", "descriptor-binding-before-read", "evidence-read-does-not-consume-mutation-guard", "positive-retry-after-on-503", "caller-safe-standard-errors"], "artifact_evidence": {"unknown_operation": {"status": 404, "code": "SANDBOX_ARTIFACT_EVIDENCE_NOT_FOUND", "retryable": false}, "source_missing": {"operation_status": "failed", "operation_read_status": 200, "status": 404, "code": "SANDBOX_ARTIFACT_EVIDENCE_NOT_FOUND", "retryable": false}, "accepted": {"operation_status": "accepted", "operation_read_status": 200, "status": 503, "code": "SANDBOX_ARTIFACT_EVIDENCE_PENDING", "retryable": true, "retry_after_required": true}, "running": {"operation_status": "running", "operation_read_status": 200, "status": 503, "code": "SANDBOX_ARTIFACT_EVIDENCE_PENDING", "retryable": true, "retry_after_required": true}, "outcome_unknown": {"operation_status": "outcome_unknown", "operation_read_status": 200, "status": 503, "code": "SANDBOX_ARTIFACT_OUTCOME_UNKNOWN", "retryable": true, "retry_after_required": true, "reconciliation_required": true}, "staged": {"operation_status": "succeeded", "operation_read_status": 200, "status": 200, "evidence_status": "staged"}, "content_rejected": {"operation_status": "failed", "operation_read_status": 200, "status": 200, "evidence_status": "rejected"}, "expired": {"status": 410, "code": "SANDBOX_ARTIFACT_EVIDENCE_EXPIRED", "retryable": false}}, "usage_evidence": {"unknown_or_absent": {"status": 404, "code": "SANDBOX_USAGE_EVIDENCE_NOT_FOUND", "retryable": false}, "known_not_yet_readable": {"status": 503, "code": "SANDBOX_USAGE_EVIDENCE_UNAVAILABLE", "retryable": true, "retry_after_required": true}, "temporarily_unavailable": {"status": 503, "code": "SANDBOX_USAGE_EVIDENCE_UNAVAILABLE", "retryable": true, "retry_after_required": true}, "available_reconciliation_statuses": {"values": ["complete", "partial", "unknown"], "status": 200}, "expired": {"status": 410, "code": "SANDBOX_USAGE_EVIDENCE_EXPIRED", "retryable": false}}, "forbids": ["billing-truth", "price", "currency", "rate", "tenant-authority"]}
  ]
}
