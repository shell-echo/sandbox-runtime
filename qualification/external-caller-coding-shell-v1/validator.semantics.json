  "cleanup_query_scope_digest_binds_target_namespace_selector_and_inspector": true,
  "cleanup_query_scope_bindings_are_all_empty_or_complete": true,
    "successful_cleanup_timestamps_cover_stability_samples": true,
    "transient_outcomes_match_profile_wire_attempt_bound": true,
    "configuration_identities_are_bound_by_process_supervisor": true,
