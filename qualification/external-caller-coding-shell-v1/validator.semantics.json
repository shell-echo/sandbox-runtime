	"sandbox_resource_projection_is_bound_by_provider_observer": true,
	"sandbox_resource_projection_is_present_iff_create_sandbox_is_observed": true,
	"sandbox_resource_projection_matches_locked_profile": true,
	"absent_payloads_cannot_leave_owned_positive_evidence": true,
	"absent_process_supervisor_requires_not_executed_scenarios": true,
	"absent_process_supervisor_suppresses_execution_timings": true,
	"absent_process_supervisor_suppresses_shell_continuity_challenge": true,
    "present_process_supervisor_requires_complete_execution_timings": true,
    "passed_scenarios_require_all_required_observations": true,
    "incomplete_scenarios_require_missing_evidence_without_observed_mismatch": true,
    "absent_resource_inspector_allows_unknown_required_cleanup_without_positive_evidence": true,
    "reconstruction_process_ids_must_change": true,
    "scenario_timestamps_follow_profile_order": true,
    "sanitization_scans_raw_and_decoded_json_for_locked_markers": true,
	"receipt_is_staged_before_final_checks_and_committed_after_final_checks": true,
    "receipt_binds_schema_and_semantics": true,
    "receipt_binds_adapter_protocol_authority": true
  }
