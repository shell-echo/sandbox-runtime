    "adapter_assigns_run_outcome": false,
    "adapter_incomplete_status_allowed": false,
    "completed_disposition_is_not_passed_evidence": true,
    "report_status_values": ["passed", "failed", "incomplete", "not_executed"],
    "report_status_derived_from_adapter_and_independent_observers": true,
    "missing_required_observation_without_observed_mismatch": "incomplete",
