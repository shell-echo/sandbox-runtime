      "invocation_accepted",
      "scenario_started",
      "scenario_result",
      "invocation_finished",
      "protocol_error"
    ],
    "invocation_framing": {
      "document_count": 1,
      "eof_required": true,
      "byte_count": "all-wire-bytes-through-eof-including-json-whitespace",
      "empty_input_allowed": false
    },
    "adapter_output_framing": {
      "delimiter": "single-lf-byte",
      "record_document_bytes_exclude_delimiter": true,
      "stdout_total_bytes_include_delimiters_and_invalid_or_truncated_bytes": true,
      "every_record_requires_delimiter": true,
      "empty_records_allowed": false,
      "carriage_return_bytes_allowed": false,
      "crlf_allowed": false,
      "complete_records_rejected_by_document_validation_count_toward_record_limit": true,
      "record_limit_failure_occurs_on_first_byte_after_max_complete_records": true
    },
    "json": {
      "utf8_required": true,
      "duplicate_member_names_allowed": false,
      "invalid_unicode_surrogate_escapes_allowed": false,
      "multiple_values_per_document_allowed": false,
      "schema_validation_required": true,
      "unknown_message_fields_allowed": false
    },
    "startup_protocol_digests_must_match_locked_authority": true,
    "invocation_failure_precedence": [
      "invocation-byte-limit",
      "stream-io-failure",
      "json-encoding-or-structure",
      "schema",
      "message-direction"
    ],
    "adapter_output_failure_precedence": [
      "stdout-byte-limit",
      "record-count-limit",
      "record-byte-limit",
      "stream-io-failure",
      "record-framing",
      "json-encoding-or-structure",
      "schema",
      "message-direction",
      "protocol-authority"
    ],
    "first_decode_failure_is_terminal": true,
    "codec_validates_message_order": false,
    "codec_launches_or_supervises_processes": false
  },
  "deadline_control": {
    "clock_source": "process-supervisor-monotonic-elapsed-time",
    "reported_wall_clock_timestamps_control_deadlines": false,
    "run_execution": {
      "start_anchor": "immediately-before-first-preflight-read",
      "success_end_anchor": "immediately-after-final-reached-phase-clean-process-exit-following-terminal-and-stdout-eof",
      "failure_end_anchor": "immediately-upon-terminal-supervisor-failure-classification-before-separate-termination-cleanup",
      "deadline_policy": "minimum-of-locked-run-execution-and-parent-context-deadline",
      "shared_across_phases": true,
      "phase_process_start_resets_deadline": false,
      "reconstruction_resets_deadline": false,
      "included_waits": [
        "startup-identity",
        "invocation-and-credential-delivery",
        "adapter-output",
        "terminal-stdout-eof-and-clean-process-exit"
      ]
    },
    "case": {
      "start_anchor": "immediately-after-supervisor-validates-prior-case-boundary",
      "first_case_prior_boundary_message_type": "invocation_accepted",
      "later_case_prior_boundary_message_type": "scenario_result",
      "timer_starts_before_waiting_for_expected_case_output": true,
      "deadline_policy": "minimum-of-locked-case-remaining-run-execution-and-parent-context-deadline",
      "applies_to_dispositions": ["completed", "not_executed"],
      "scenario_started_resets_deadline": false,
      "retries_or_transient_outcomes_reset_deadline": false
    },
    "expiry": {
      "effective_deadline_expiry_failure": "deadline-exceeded",
      "parent_cancellation_before_effective_deadline_failure": "context-canceled",
      "simultaneous_event_policy": "deadline-preempts-events-observed-at-or-after-effective-deadline"
    },
    "termination": {
      "start_anchor": "immediately-before-close-supervisor-owned-io",
      "scope": [
        "close-supervisor-owned-io",
        "kill-process-group",
        "bounded-wait-and-reap"
      ],
      "deadline_policy": "separate-cleanup-context-with-locked-process-reap-limit",
      "timeout_result": "incomplete"
    },
    "definition_verifier_claims_runtime_deadline_enforcement": false
  },
  "startup_identity": {
    "message_type": "startup_identity",
    "sequence": 0,
    "required_embedded_identities": [
      "protocol_schema_digest",
      "protocol_semantics_digest",
      "caller_release_identity",
      "adapter_release_identity",
