      "profile_id",
      "profile_version",
      "profile_digest"
    ],
    "expected_values_injected_by_harness": false,
    "combined_frame_is_caller_owner_assertion": true,
    "process_supervisor_must_independently_bind_actual_artifacts_and_processes": true,
    "identity_mismatch_behavior": "reject-before-harness-input"
  },
  "invocation": {
    "one_process_invocation_per_phase": true,
    "run_phase_order": ["initial", "reconstruction"],
    "phase_invocation_ids_must_differ": true,
    "restart_processes_between_phases": [
