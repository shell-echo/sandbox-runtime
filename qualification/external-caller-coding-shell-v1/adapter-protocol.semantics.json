    "working_directory_policy": "supervisor-owned-empty-directory",
    "credential_transport": "dedicated-inherited-readable-anonymous-pipes",
    "ephemeral_file_transport_supported": false
  },
  "limits": {
    "max_invocation_bytes": 32768,
    "max_adapter_output_record_bytes": 65536,
    "max_adapter_output_records_per_process": 33,
    "max_adapter_output_sequence": 32,
    "max_adapter_stdout_bytes": 2097152,
    "max_adapter_stderr_bytes": 262144,
    "max_credential_channels": 8,
    "max_credential_channel_bytes": 1048576,
    "max_credential_total_bytes": 4194304,
    "max_case_seconds": 120,
    "max_execution_seconds": 1800,
    "max_process_reap_seconds": 5
