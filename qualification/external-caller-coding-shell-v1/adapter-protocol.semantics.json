    ],
    "location_policy": {
      "path_profile": "absolute-clean-posix-portable-filename-v1",
      "uri_profile": "canonical-secure-uri-v1",
      "profile_path_binding": "same-read-only-regular-file-opened-without-symlinks-and-verified-as-locked-profile",
      "caller_state_root_binding": "same-private-directory-opened-without-symlinks-created-empty-before-initial-and-unread-unmodified-unreplaced-by-harness",
      "provider_origin_policy": "https-origin-without-path-userinfo-query-fragment-percent-encoding-or-explicit-default-port",
      "gateway_probe_endpoint_policy": "https-or-wss-endpoint-with-required-static-clean-path-without-userinfo-query-fragment-percent-encoding-or-explicit-default-port",
      "host_policy": "lowercase-ldh-dns-not-ending-in-whatwg-ipv4-number-or-canonical-ip-literal",
      "ipv4_policy": "four-shortest-decimal-octets",
      "ipv6_policy": "non-ipv4-mapped-rfc5952-literal",
      "port_policy": "omitted-or-nondefault-shortest-decimal-1-through-65535",
      "gateway_scheme_rewrite_allowed": false,
      "values_source": "qualification-operator-and-process-supervisor-static-preflight-only",
      "values_commitment": "adapter-configuration-digest-finalized",
      "values_commitment_configuration_id": "adapter_configuration",
      "values_commitment_digest_profile": "rfc8785-full-document-v1",
      "values_frozen_before": [
        "credential-material-acquisition-or-generation",
        "forbidden-correlation-material-acquisition-or-generation",
        "adapter-process-start",
        "provider-or-gateway-network-io"
      ],
      "values_identical_across_phases": [
        "profile_path",
        "provider_origin",
        "gateway_probe_endpoint",
        "caller_state_root"
      ],
      "values_derived_from_forbidden_correlation": false,
      "values_derived_from_credential_payload": false,
      "derivation_and_order_proof_observer": "process_supervisor",
      "operator_upstream_non_derivation_is_trusted_input": true,
      "definition_verifier_claims_derivation_or_order_proof": false,
      "location_values_in_sanitized_transcript": false,
      "runtime_binding_observer": "process_supervisor",
      "runtime_location_overlap_forbidden": [
        "profile_path:caller_state_root",
        "profile_path:working_directory",
        "profile_path:evidence_root",
        "caller_state_root:working_directory",
        "caller_state_root:evidence_root"
      ]
    },
    "caller_state_root_policy": "created-empty-before-initial-and-unread-unmodified-by-harness-through-reconstruction",
    "evidence_root_exposed_to_adapter": false
  },
  "credential_channels": {
    "roles": [
      "provider_credentials",
      "provider_trust",
      "gateway_credentials",
      "gateway_trust"
    ],
    "requirement_descriptor_exact_match": true,
    "unique_channel_ids": true,
    "unique_file_descriptors": true,
    "single_eof_framed_payload": true,
    "close_on_exec_except_explicit_target": true,
    "payload_is_private_and_not_evidence": true,
    "payload_must_not_contain_correlation_reinjection": true,
    "unknown_or_ambiguous_delivery_behavior": "terminate-and-reap"
  },
  "state_machine": {
    "scope": "one-fresh-adapter-process-and-one-phase",
    "initial_state": "awaiting-startup",
    "states": [
      "awaiting-startup",
      "ready-for-invocation",
      "awaiting-invocation-acceptance",
      "awaiting-next-scenario",
      "awaiting-started-result",
      "awaiting-terminal",
      "terminal-observed",
      "terminal-eof-observed",
      "complete",
      "failed"
    ],
    "harness_input_event": "validated-invocation-delivered",
    "transition_table": [
      {
        "from": ["awaiting-startup"],
        "event": "startup_identity",
        "guard": "sequence-zero-and-locked-startup-authority",
        "to": "ready-for-invocation"
      },
      {
        "from": ["ready-for-invocation"],
        "event": "validated-invocation-delivered",
        "guard": "single-schema-valid-invocation-delivered-and-supervisor-reference-captured",
        "to": "awaiting-invocation-acceptance"
      },
      {
        "from": ["awaiting-invocation-acceptance"],
        "event": "invocation_accepted",
        "guard": "sequence-one-and-reference-binding-valid",
        "to": "awaiting-next-scenario"
      },
      {
        "from": ["awaiting-invocation-acceptance"],
        "event": "protocol_error",
        "guard": "pre-binding-invalid-invocation-branch",
        "to": "terminal-observed"
      },
      {
        "from": ["awaiting-next-scenario"],
        "event": "scenario_started",
        "guard": "next-locked-profile-case",
        "to": "awaiting-started-result"
      },
      {
        "from": ["awaiting-next-scenario"],
        "event": "scenario_result",
        "guard": "next-locked-profile-case-not-executed-and-more-cases-remain",
        "to": "awaiting-next-scenario"
      },
      {
        "from": ["awaiting-next-scenario"],
        "event": "scenario_result",
        "guard": "final-locked-profile-case-not-executed",
        "to": "awaiting-terminal"
      },
      {
        "from": ["awaiting-started-result"],
        "event": "scenario_result",
        "guard": "same-locked-profile-case-completed-and-more-cases-remain",
        "to": "awaiting-next-scenario"
      },
      {
        "from": ["awaiting-started-result"],
        "event": "scenario_result",
        "guard": "same-final-locked-profile-case-completed",
        "to": "awaiting-terminal"
      },
      {
        "from": ["awaiting-next-scenario", "awaiting-started-result", "awaiting-terminal"],
        "event": "protocol_error",
        "guard": "post-binding-failure-branch-and-next-contiguous-sequence",
        "to": "terminal-observed"
      },
      {
        "from": ["awaiting-terminal"],
        "event": "invocation_finished",
        "guard": "next-contiguous-sequence-and-completion-matches-dispositions",
        "to": "terminal-observed"
      },
      {
        "from": ["terminal-observed"],
        "event": "stdout_eof",
        "guard": "no-post-terminal-byte-observed",
        "to": "terminal-eof-observed"
      },
      {
        "from": ["terminal-eof-observed"],
        "event": "clean_process_exit",
        "guard": "bounded-wait-reported-successful-process-exit",
        "to": "complete"
      }
    ],
    "undefined_transition_result": "failed",
    "decode_failure_from_nonterminal_result": "failed",
    "stdout_eof_before_terminal_result": "failed",
    "byte_after_terminal_result": "failed",
    "process_exit_event_source": "bounded-wait-after-stdout-eof-drain",
    "non_clean_process_exit_result": "failed",
    "complete_and_failed_states_are_absorbing": true,
    "startup_identity_records_per_process": 1,
    "startup_identity_records_per_complete_run": 2,
    "startup_identity_cross_phase_equality": "rfc8785-canonical-complete-record-identical",
    "report_startup_identity_projection": "locked-report-fields-from-both-canonical-equal-startup-records",
    "reconstruction_start_precondition": "initial-state-machine-complete-and-initial-process-cleanly-exited",
    "adapter_output_sequence_starts_at": 1,
    "adapter_output_sequence_increment": 1,
    "first_post_invocation_message": "invocation_accepted",
    "output_binding_reference": "single-validated-inbound-invocation-document-for-process",
    "output_binding_message_types": [
      "invocation_accepted",
      "scenario_started",
      "scenario_result",
      "invocation_finished"
    ],
    "output_invocation_id_binding": "byte-identical-to-reference-invocation-id",
    "output_phase_binding": "exactly-equal-to-reference-invocation-phase",
    "scenario_case_phase_binding": "case-id-prefix-equals-reference-invocation-phase",
    "output_binding_mismatch_behavior": "invalid-or-out-of-order-message",
    "protocol_error_binding": "branch-selected-by-error-code",
    "definition_verifier_claims_runtime_output_binding": false,
    "scenario_order_source": "locked-profile-phase-order",
    "completed_scenario_requires_started_message": true,
    "not_executed_scenario_forbids_started_message": true,
    "normal_terminal_requires_exactly_one_result_per_phase_scenario": true,
    "protocol_error_may_terminate_before_remaining_scenario_results": true,
    "unreported_scenarios_after_protocol_error_are_not_adapter_not_executed_assertions": true,
    "result_dispositions": ["completed", "not_executed"],
    "invocation_finished_completion": {
      "completed": "every-phase-scenario-disposition-completed",
      "stopped": "at-least-one-phase-scenario-disposition-not-executed"
    },
    "terminal_message_types": ["invocation_finished", "protocol_error"],
    "exactly_one_terminal_message": true,
    "output_after_terminal_forbidden": true,
    "stdout_eof_after_terminal_required": true,
    "clean_process_exit_after_terminal_required": true,
    "definition_verifier_claims_runtime_state_machine_enforcement": false
  },
  "protocol_error": {
    "branch_selector": "error_code",
    "invocation_id_and_phase_nullability": "both-null-or-both-non-null",
    "pre_binding_invalid_invocation": {
      "error_codes": ["invalid_invocation"],
