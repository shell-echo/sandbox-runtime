      "reference_invocation_bound": true,
      "requires_invocation_accepted": true,
      "sequence": "next-contiguous-adapter-output-sequence",
      "invocation_id": "byte-identical-to-reference-invocation-id",
      "phase": "exactly-equal-to-reference-invocation-phase",
      "prior_post_invocation_output_allowed": true
    },
    "complete_record_required": true,
    "output_failed_emission_precondition": "no-bytes-of-failed-normal-record-written-and-complete-protocol-error-record-remains-writable",
    "partial_record_or_write_failure_observation": "invalid-or-truncated-output-observed-by-process-supervisor",
    "terminal": true,
    "mutually_exclusive_with_invocation_finished": true,
    "output_after_terminal_forbidden": true,
    "adapter_assigns_report_status": false,
    "adapter_assigns_run_outcome": false,
    "definition_verifier_claims_runtime_protocol_error_handling": false
  },
  "progress_semantics": {
    "message_types": [
      "invocation_accepted",
      "scenario_started",
      "scenario_result",
      "invocation_finished",
      "protocol_error"
