  "transport_profile": {
    "transport_id": "darwin-linux-inherited-pipe-v1",
    "protocol_data_language": "language-neutral-json",
    "supported_platforms": ["darwin", "linux"],
    "unsupported_platform_behavior": "fail-closed-before-process-start",
    "invocation_framing": "one-strict-utf8-json-document-then-eof",
    "adapter_output_framing": "strict-utf8-json-lines-with-lf",
    "stderr_role": "bounded-untrusted-diagnostics-only",
    "startup_before_harness_input": true,
    "startup_before_credential_delivery": true,
    "fixed_empty_argv": true,
